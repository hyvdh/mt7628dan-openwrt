CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_mt7628dan_dev_ab=y
CONFIG_SQUASHFS_XZ=y
# 生产内核瘦身(镜像≤3.4MB, 满足A/B双槽预算)
# CONFIG_KERNEL_KALLSYMS is not set
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_KERNEL_MAGIC_SYSRQ is not set
# CONFIG_KERNEL_SWAP is not set

# CH9437F 串口扩展驱动
CONFIG_PACKAGE_kmod-ch9437=y
CONFIG_PACKAGE_kmod-ch9437-dev=y

# EC200A 4G 模组: USB host 栈 + option 串口驱动 + ECM 数据通路
# (EC200A 仅支持 ECM/RNDIS 网卡模式, 不支持 QMI, 见 AT 手册 AT+QCFG="usbnet")
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
